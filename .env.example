# Redis queue (Coolify internal network for server, external URL for local poller)
REDIS_URL=redis://default:<password>@<host>:<port>/0

# GitHub webhook secret (set the same value in each repo's webhook settings)
GITHUB_WEBHOOK_SECRET=your-secret-here

# Server port (index.ts only)
PORT=3000

# Paperclip (poller.ts only)
PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=your-company-id
PAPERCLIP_CEO_AGENT_ID=your-ceo-agent-id

# Comma-separated repo:agent-id pairs (poller.ts only)
REPO_AGENT_MAP=org/repo1:agent-id-1,org/repo2:agent-id-2

# Poll interval in ms (default: 30000)
POLL_INTERVAL_MS=30000
